seqfile = FKS1.interspecific_OF3.MDRclade.renamed.CDS_pal2nal.trimmed.phy
treefile = FKS1.interspecific_OF3.MDRclade_Ckru.renamed.mafft_auto.clipkit.raxmlng_b1000.raxml.bestTree.rt_fixed
outfile = FKS1.interspecific_OF3.MDRclade.mafft_auto.clipkit.branch-test.M1_cfreq2

noisy = 3
verbose = 1

seqtype = 1
ndata = 1
icode = 8
cleandata = 0

model = 1 * Enable 2 or more ω for branches [2, 3]
NSsites = 0 * One ω for all sites (M0 and branch model)
CodonFreq = 2 * Use mutation-selection model
estFreq = 0 * Use observed frequencies to calculate fitness/freq pars
clock = 0 * Assume no clock
fix_omega = 0 * Enables option to estimate omega
omega = 0.5 * Initial omega value
